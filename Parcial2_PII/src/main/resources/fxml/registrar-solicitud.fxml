<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.controller.RegistrarSolicitudController" style="-fx-background-color: linear-gradient(to bottom right, #EEF2FF, #F8FAFC 55%, #ECFDF5); -fx-padding: 36px; -fx-font-family: 'Segoe UI';">
 <top><Label text="Nueva solicitud de servicio" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/></top>
 <center><VBox spacing="10" maxWidth="560" BorderPane.alignment="CENTER"><Label text="Datos de la solicitud" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/><Label text="Código único"/><TextField fx:id="codigo" promptText="Ej. SOL-001"/><Label text="Documento (texto)"/><TextField fx:id="documento" promptText="Ej. 1090123456"
 /><Label text="Nombre completo"/><TextField fx:id="nombre" promptText="Ej. Ana Pérez"/><Label text="Correo electrónico"/><TextField fx:id="correo" promptText="Ej. ana@correo.com"/><Label text="Servicio tecnológico"/><ComboBox fx:id="tipoServicio" maxWidth="Infinity"/><Label fx:id="costoPreview" style="-fx-text-fill: #F59E0B; -fx-font-weight: bold;"/><Label text="Observaciones (opcional)"/><TextField fx:id="observaciones" promptText="Escribe observaciones adicionales"
 /><Label fx:id="mensaje" wrapText="true"/><HBox spacing="12"><Button text="Guardar solicitud" onAction="#guardar" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12px 22px; -fx-background-radius: 8px;"/><Button text="Volver" onAction="#volver" style="-fx-background-color: #64748B; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12px 22px; -fx-background-radius: 8px;"/></HBox></VBox></center>
</BorderPane>
