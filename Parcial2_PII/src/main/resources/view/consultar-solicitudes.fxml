<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.viewController.ConsultarSolicitudesController" style="-fx-background-color: linear-gradient(to bottom right, #EEF2FF, #F8FAFC 55%, #ECFDF5); -fx-padding: 36px; -fx-font-family: 'Segoe UI';">
 <top><Label text="Consultar solicitudes" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/></top>
 <center><VBox alignment="CENTER" spacing="14" maxWidth="560"><Label text="Código de solicitud"/><TextField fx:id="codigo" promptText="Ej. SOL-001"/><HBox alignment="CENTER" spacing="12"><Button text="Consultar" onAction="#consultar" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12px 22px; -fx-background-radius: 8px;"/><Button text="Eliminar" onAction="#eliminar" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12px 22px; -fx-background-radius: 8px;"
 /></HBox><Label fx:id="resultado" wrapText="true" minHeight="100"/><Separator/><Label text="Consulta de técnico por especialidad"/><ComboBox fx:id="especialidad" maxWidth="Infinity"/><Button text="Consultar disponibilidad" onAction="#consultarTecnico" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 18px; -fx-background-radius: 8px;"/><Label fx:id="tecnico"/><Button text="Volver" onAction="#volver" style="-fx-background-color: #64748B; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12px 22px; -fx-background-radius: 8px;"/></VBox></center>
</BorderPane>
