<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.viewController.CatalogoController" style="-fx-background-color: linear-gradient(to bottom right, #EEF2FF, #F8FAFC 55%, #ECFDF5); -fx-padding: 36px; -fx-font-family: 'Segoe UI';">
 <top><Label text="Catálogo de servicios" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/></top>
 <center><ScrollPane fitToWidth="true" style="-fx-background-color: transparent;"><VBox alignment="CENTER" spacing="12" maxWidth="600" style="-fx-padding: 10px;"><Label text="Servicios individuales" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/><ComboBox fx:id="servicioSeleccionado" promptText="Selecciona un servicio" maxWidth="Infinity"/><HBox spacing="10"><Button text="Ver detalle" onAction="#verDetalle" style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 18px; -fx-background-radius: 8px;"
 /><Button text="Agregar al paquete" onAction="#agregarAlPaquete" style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 18px; -fx-background-radius: 8px;"/></HBox><Label fx:id="detalleServicio" wrapText="true" minHeight="80" style="-fx-background-color: white; -fx-border-color: #6366F1; -fx-border-radius: 8px; -fx-padding: 18px; -fx-text-fill: #334155;"
 /><Label text="Configuración de paquete tecnológico" style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 10px;"/><TextField fx:id="codigoPaquete" promptText="Código del paquete, ej. PAQ-001"/><TextField fx:id="nombrePaquete" promptText="Nombre del paquete"/><TextField fx:id="descripcionPaquete" promptText="Descripción del paquete (opcional)"/><TextField fx:id="descuentoPaquete" promptText="Descuento en porcentaje, ej. 10"/><Label text="Componentes seleccionados" style="-fx-font-weight: bold; -fx-text-fill: #1E293B;"/><ListView fx:id="serviciosPaquete" prefHeight="100"/><HBox spacing="10"><Button text="Quitar seleccionado" onAction="#quitarDelPaquete" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px 14px; -fx-background-radius: 8px;"/><Button text="Crear paquete" onAction="#crearPaquete" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px 14px; -fx-background-radius: 8px;"/></HBox><Label fx:id="resultadoPaquete" wrapText="true" minHeight="45"/><Button text="Volver al inicio" onAction="#volver" style="-fx-background-color: #64748B; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12px 22px; -fx-background-radius: 8px;"/></VBox></ScrollPane></center>
</BorderPane>
