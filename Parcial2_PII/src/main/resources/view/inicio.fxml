<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.viewController.InicioController" style="-fx-background-color: linear-gradient(to bottom right, #EEF2FF, #F8FAFC 55%, #ECFDF5); -fx-padding: 36px; -fx-font-family: 'Segoe UI';">
    <top><VBox style="-fx-padding: 14px 0 28px 0;"><Label text="TECH SOLUTIONS" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/><Label text="Gestión inteligente de servicios tecnológicos" style="-fx-font-size: 15px; -fx-text-fill: #64748B;"/></VBox></top>
    <center><VBox alignment="CENTER" spacing="18" maxWidth="480" style="-fx-background-color: rgba(255,255,255,0.82); -fx-background-radius: 18px; -fx-padding: 34px; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.16), 18, 0.2, 0, 6);"><Label text="¿Qué deseas gestionar?" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"
    /><Button text="Registrar solicitud" onAction="#abrirRegistro" maxWidth="Infinity" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12px 22px; -fx-background-radius: 8px;"/><Button text="Consultar solicitudes" onAction="#abrirConsultas" maxWidth="Infinity" style="-fx-background-color: #64748B; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12px 22px; -fx-background-radius: 8px;"
    /><Button text="Catálogo y paquetes" onAction="#abrirCatalogo" maxWidth="Infinity" style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12px 22px; -fx-background-radius: 8px;"/></VBox></center>
</BorderPane>
